---
import { profile } from '../lib/profile';
---

<ul
  class="reveal mt-20 grid gap-x-10 gap-y-6 border-t border-rule pt-8 [animation-delay:240ms] sm:grid-cols-2 lg:grid-cols-4"
>
  {
    profile.credentials.map((item) => (
      <li class="border-l-2 border-bronze pl-4 text-small text-muted">{item}</li>
    ))
  }
</ul>
