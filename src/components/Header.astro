---
import { profile } from '../lib/profile';

// Links start with "/" so they also work from a story page.
const links = [
  { href: '/#experience', label: 'Experience' },
  { href: '/#impact', label: 'Impact' },
  { href: '/#expertise', label: 'Expertise' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b border-rule/70 bg-stone/90 backdrop-blur">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-8 gap-y-2 px-6 py-4 sm:px-10"
  >
    <a href="/" class="font-serif text-lead tracking-tight">{profile.name}</a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-small text-muted">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-bronze">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
