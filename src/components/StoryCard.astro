---
import type { CollectionEntry } from 'astro:content';
import Verify from './Verify.astro';

interface Props {
  story: CollectionEntry<'stories'>;
  index: number;
}

const { story, index } = Astro.props;
const { title, summary, proof } = story.data;
---

<article class="group grid gap-6 py-12 sm:grid-cols-[4rem_1fr] sm:gap-10">
  <p class="font-serif text-section leading-none text-bronze" aria-hidden="true">
    {String(index + 1).padStart(2, '0')}
  </p>
  <div>
    <h3 class="font-serif text-lead sm:text-[1.75rem]">
      <a href={`/stories/${story.id}/`} class="transition-colors group-hover:text-bronze">
        {title}
      </a>
    </h3>
    <p class="mt-3 max-w-2xl text-ink/85">{summary}</p>
    {
      proof.length > 0 && (
        <ul class="mt-6 space-y-2">
          {proof.map((item) => (
            <li class="flex gap-3 text-small text-muted">
              <span class="mt-[0.55em] h-px w-4 shrink-0 bg-bronze" aria-hidden="true" />
              <span>
                <Verify text={item} />
              </span>
            </li>
          ))}
        </ul>
      )
    }
    <a
      href={`/stories/${story.id}/`}
      class="mt-6 inline-block text-small font-medium text-bronze underline-offset-4 hover:underline"
    >
      Read the story <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
