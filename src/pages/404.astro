---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="mx-auto max-w-5xl px-6 py-32 sm:px-10">
    <p class="eyebrow">404</p>
    <h1 class="mt-5 font-serif text-section tracking-tight">This page doesn't exist.</h1>
    <a href="/" class="mt-8 inline-block text-bronze underline-offset-4 hover:underline">
      Back to the home page
    </a>
  </section>
</Base>
